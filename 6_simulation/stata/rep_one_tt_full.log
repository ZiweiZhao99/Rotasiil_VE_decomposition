>     B0(real) B1(real) Theta(real) Eventdep(real) Posth(name)
  2. 
.     tempname maxgamma
. * Collect unique event times for splitting
. ****************************************************
. preserve
  3.     scalar `maxgamma' = .
  4. 
.     preserve
  5.         clear
  6.         set obs `n'
  7.         gen long id = _n
  8.         gen byte Z  = (id <= `n'/2)
  9.         gen double frailty = rgamma(1/`theta', `theta')
 10.         quietly summarize frailty, meanonly
 11.         scalar `maxgamma' = r(max)
 12.         tempfile subj
 13.         save `subj', replace
 14.     restore
 15. 
.     scalar lambda_upper = 1.5 * `peak' * scalar(`maxgamma')
 16. 
.     postfile `posth' long id double start double end byte event byte Z ///
>         using "`using'", replace
 17. 
.     use `subj', clear
 18.     sort id
 19. 
.     quietly {
 20.         forvalues i = 1/`n' {
 21.             quietly summarize Z if id==`i', meanonly
 22.             local Zi = r(mean)
 23.             quietly summarize frailty if id==`i', meanonly
 24.             local gi = r(mean)
 25. 
.             local Tstar = 0
 26.             local prev  = 0
 27.             local j     = 0
 28. 
.             while (`Tstar' < `tau') {
 29.                 local R = -ln(runiform()) / scalar(lambda_upper)
 30.                 local Tstar = `Tstar' + `R'
 31.                 if (`Tstar' >= `tau') {
 32.                     continue, break
 33.                 }
 34.                 local v = runiform()
 35.                 local lam0 = `peak' * exp(-`decay' * `Tstar')
 36.                 local lamt  = `lam0' * exp((`b0' + `b1'*ln(`Tstar')) * `Zi
> ')
 37.                 local inten = ((`j'+1)^(`eventdep')) * `gi' * `lamt'
 38.                 if (`inten' >= `v' * scalar(lambda_upper)) {
 39.                     local j = `j' + 1
 40.                     post `posth' (`i') (`prev') (`Tstar') (1) (`Zi')
 41.                     local prev = `Tstar'
 42.                 }
 43.             }
 44.             post `posth' (`i') (`prev') (`tau') (0) (`Zi')
 45.         }
 46.     }
 47. 
.     postclose `posth'
 48.     use "`using'", clear
 49. end
